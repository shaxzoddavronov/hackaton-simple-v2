# QueryMind AI backend — copy to `.env` and fill in real values.
# Never commit a populated `.env` file.

# --- Application metadata DB (Postgres in prod, SQLite for unit tests) ---
DATABASE_URL=postgresql+asyncpg://querymind:querymind@localhost:5432/querymind

# --- Broker / cache for Celery + rate-limit / circuit-breaker state ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRES_MIN=60

# --- Credential-at-rest encryption master key (AES-GCM / Fernet) ---
# Must be a url-safe base64-encoded 32-byte key. Generate one of:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
QM_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Local LLM (vLLM, OpenAI-compatible API). External APIs are forbidden. ---
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=google/gemma-3-4b-it

# --- Triton Inference Server (embeddings ONLY — never LLM) ---
# Triton serves the bge-m3 embedding model on its V2 HTTP inference API.
# Leave TRITON_URL empty to disable RAG entirely; the retriever then falls
# back to BM25 pruning and the agent stays functional.
TRITON_URL=http://localhost:8001
TRITON_EMBED_MODEL=bge_m3
# Leave version blank for "latest". Pin to a number (e.g. "1") for repro.
TRITON_EMBED_MODEL_VERSION=
TRITON_TIMEOUT_S=30

# Auth: required only when Triton sits behind a proxy / NIM / ingress
# that enforces a token. Leave TRITON_API_KEY blank for an unauth'd local
# Triton. Common combos:
#   NVIDIA NIM      : TRITON_AUTH_HEADER=Authorization  TRITON_AUTH_SCHEME=Bearer
#   API gateway     : TRITON_AUTH_HEADER=x-api-key      TRITON_AUTH_SCHEME=
TRITON_API_KEY=
TRITON_AUTH_HEADER=Authorization
TRITON_AUTH_SCHEME=Bearer

# Must match the embedding model's output dimension (bge-m3 = 1024).
# Changing this requires re-running the 0002_rag migration with a new
# vector(N) width and re-embedding every chunk.
EMBEDDING_DIM=1024

# --- RAG behaviour ---
RAG_TOP_K=12
RAG_INDEX_BATCH=32
# Celery Beat fires the daily schema-diff job at this UTC time. The job
# walks every workspace, detects structural drift, and re-indexes only
# what changed. Set both to a small value to test the path manually.
RAG_DIFF_CHECK_HOUR_UTC=0
RAG_DIFF_CHECK_MINUTE_UTC=0
