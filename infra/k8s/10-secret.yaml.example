# QueryMind AI — secret template.
#
# IMPORTANT
# ---------
# 1. Copy this file to `10-secret.yaml` in the same directory.
# 2. Replace every `<replace-me>` placeholder with a real value.
# 3. Apply with `kubectl apply -f infra/k8s/10-secret.yaml`.
# 4. NEVER commit `10-secret.yaml`. It is added to .gitignore.
#
# Generators (run on a workstation, NOT in CI):
#   QM_MASTER_KEY:  python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#   JWT_SECRET:     openssl rand -base64 48
#
# The backend lifespan hook (main.py::_check_secrets) refuses to boot when
# QM_ENVIRONMENT=production and either secret is the dev default, so leaving
# placeholders here will make the pods CrashLoop on purpose.
apiVersion: v1
kind: Secret
metadata:
  name: querymind-secrets
  namespace: querymind
  labels:
    app.kubernetes.io/name: querymind
    app.kubernetes.io/component: secrets
    app.kubernetes.io/version: "0.1.0"
type: Opaque
stringData:
  # 32-byte url-safe base64 key for AES-GCM credential encryption.
  QM_MASTER_KEY: "<replace-me>"
  # >=32-char secret for JWT signing (HS256).
  JWT_SECRET: "<replace-me>"
  # Async SQLAlchemy URL pointing at the in-cluster Postgres service.
  # Example: postgresql+asyncpg://querymind:<password>@postgres.querymind.svc.cluster.local:5432/querymind
  DATABASE_URL: "<replace-me>"
  # Celery broker + slowapi rate-limit storage (db=0 / db=1 split).
  REDIS_URL: "redis://redis.querymind.svc.cluster.local:6379/0"
  # Bearer token for the vLLM endpoint. Use "not-needed" for an
  # unauthenticated local vLLM; required when behind a gateway.
  VLLM_API_KEY: "<replace-me>"
