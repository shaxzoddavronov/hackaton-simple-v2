# Triton model config for bge-m3 served via the Python backend.
#
# Shape contract — must match `app/services/rag/triton_client.py`:
#   * Input  "TEXT": BYTES, 1-D variable length. The client packs N
#     strings as `{"name":"TEXT","shape":[N],"datatype":"BYTES",
#     "data":["text1","text2",...]}`.
#   * Output "embedding": FP32, shape [N, 1024]. bge-m3's pooled +
#     L2-normalized dense vector dimension is 1024.
#
# `max_batch_size: 0` disables Triton's auto-batching wrapper, so the
# inner Python `execute()` function sees exactly what the client sent
# without an extra batch axis injected on top. Real batching is done
# CLIENT-side via the existing `RAG_INDEX_BATCH` setting — that keeps
# the Python backend simple and predictable.
#
# Hardware target: NVIDIA L40S (Ada Lovelace, sm_89, 48 GB VRAM).
# A single bge-m3 in FP16 is ~1.2 GB; with batch=64 the activation
# budget runs to ~3 GB. We co-locate TWO model instances on the same
# GPU so concurrent indexing jobs from Celery don't queue (each Triton
# instance gets its own Python interpreter + its own model copy).

name: "bge_m3"
backend: "python"
max_batch_size: 0

input [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [ -1 ]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [ -1, 1024 ]
  }
]

# Two GPU instances on device 0. L40S has 48 GB; two FP16 instances +
# activations + cuDNN scratch land around 12 GB total, leaving plenty
# of room for other co-tenants (e.g., the vLLM that already shares the
# host GPU in single-node deployments). Bump `count` to 3 if you're
# running a dedicated embedding host with no co-tenants.
#
# To roll back to CPU mode on a non-GPU host: change `kind` to
# `KIND_CPU` and set `TRITON_FORCE_CPU=1` on the container.
instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Triton-side optimisations. Disabled by default because the Python
# backend does its own batching internally via sentence-transformers.
# Set `dynamic_batching { preferred_batch_size: [32] }` only if you
# move to ONNX or TensorRT — for the Python path, client-side batching
# via RAG_INDEX_BATCH is already optimal.
#
# parameters [{ key: "FORCE_CPU_ONLY_INPUT_TENSORS", value: { string_value: "no" } }]
