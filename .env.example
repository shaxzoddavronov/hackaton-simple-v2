# ── Metadata database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://querymind:querymind@localhost:5432/querymind

# ── Redis (Celery broker + result backend) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod-32-chars-minimum
JWT_ALG=HS256
JWT_EXPIRES_MIN=60

# ── Credential encryption ───────────────────────────────────────────────────
# 32-byte key, base64-encoded. Used to encrypt user-supplied DB connection
# strings at rest before they hit the metadata Postgres.
# generate via: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
QM_MASTER_KEY=

# ── vLLM (local, OpenAI-compatible) ─────────────────────────────────────────
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=google/gemma-3-4b-it

# ── Triton Inference Server (embeddings only — never LLM) ───────────────────
# Set TRITON_URL="" to disable RAG (retriever falls back to BM25).
TRITON_URL=http://localhost:8001
TRITON_EMBED_MODEL=bge_m3
TRITON_EMBED_MODEL_VERSION=
TRITON_TIMEOUT_S=30

# Auth — only needed when Triton is behind a gateway/NIM/ingress.
# Leave TRITON_API_KEY empty for unauth'd local Triton.
TRITON_API_KEY=
TRITON_AUTH_HEADER=Authorization
TRITON_AUTH_SCHEME=Bearer

# bge-m3 = 1024; changing this requires re-embedding every chunk.
EMBEDDING_DIM=1024

# ── RAG behaviour ───────────────────────────────────────────────────────────
RAG_TOP_K=12
RAG_INDEX_BATCH=32
RAG_DIFF_CHECK_HOUR_UTC=0
RAG_DIFF_CHECK_MINUTE_UTC=0
